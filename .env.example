# Supabase（supabase/README.md 参照）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用（クライアントに露出させない）
SUPABASE_SERVICE_ROLE_KEY=

# 履歴書ツール（このシステムの /resume と GitHub Pages の旧ツール）の自動翻訳（/api/translate）で使う
# Anthropic のAPIキー。未設定でも履歴書ツールは動く（自由記述が入力言語のまま出るだけ）
ANTHROPIC_API_KEY=
# /api/translate の呼び出しを許す元のURL（カンマ区切り・任意）。
# このシステム自身（/resume）はいつでも許可。既定で https://akina12231988-star.github.io も許可している
TRANSLATE_ALLOWED_ORIGINS=

# 入管メール通知（Gmail → Apps Script → /api/mail/inbound）の共有シークレット。
# Apps Script 側の SECRET と必ず同じ値にする（推測されない長いランダム文字列）。
MAIL_INBOUND_SECRET=
